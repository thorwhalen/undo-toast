{
  "name": "undo-toast",
  "version": "0.1.0",
  "description": "Agent-first undo toasts: a decision function that says whether and how to offer undo for an action (duration, labels, keys, what closing means, and why), a framework-free offer store, and a React toast that follows the standard.",
  "author": "Thor Whalen",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thorwhalen/undo-toast.git"
  },
  "homepage": "https://github.com/thorwhalen/undo-toast#readme",
  "bugs": {
    "url": "https://github.com/thorwhalen/undo-toast/issues"
  },
  "keywords": [
    "undo",
    "toast",
    "snackbar",
    "notification",
    "accessibility",
    "wcag",
    "react",
    "agent",
    "ux"
  ],
  "bin": {
    "undo-toast": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
